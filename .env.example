# ─── Telegram (optional) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_TIER_MIN=1
ALERT_DRY_RUN=0

# ─── Optional market-data provider ────────────────────────────────────
ALPHA_VANTAGE_API_KEY=

# ─── Optional FRED economic-data provider ──────────────────────────────
FRED_API_KEY=

# ─── Optional BEA economic-data provider ────────────────────────────────
BEA_API_KEY=

# ─── Runtime ────────────────────────────────────────────────────────────
CNE_DATA_DIR=./data
DATABASE_URL=
CNE_LOG_LEVEL=INFO
CNE_LOG_FILE=

# ─── Optional Google OAuth dashboard access ────────────────────────────
CNE_AUTH_ENABLED=0
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CNE_OAUTH_COOKIE_SECRET=
CNE_OAUTH_REDIRECT_URI=
CNE_OAUTH_ALLOWED_EMAILS=

# ─── Sizing ─────────────────────────────────────────────────────────────
CNE_ACCOUNT_SIZE=10000
CNE_KELLY_FRACTION=0.5
CNE_MAX_RISK_PCT=2.0

# ─── Horizons ───────────────────────────────────────────────────────────
CNE_LOOKBACK_YEARS=3
CNE_SNAPSHOT_DAYS_BACK=45
CNE_LEARN_DAYS_BACK=120
CNE_COLLECTION_INTERVAL_MINUTES=5
CNE_PREPARATION_WINDOWS_MINUTES=60,15,1
# Optional event-code weight overrides; example: {"US_CPI_YOY":2.5}
CNE_FUNDAMENTAL_EVENT_WEIGHTS_JSON={}
CNE_FUNDAMENTAL_DECAY_HALF_LIFE_DAYS=14
CNE_FUNDAMENTAL_WINDOW_DAYS=30
CNE_SURPRISE_NORMALIZATION_MIN_SAMPLES=12